# =============================================================================
# Áurea Custódia — variáveis de ambiente
# =============================================================================
# A camada de persistência é escolhida automaticamente pelo que estiver definido
# aqui, nesta ordem de prioridade (src/server/store/index.ts):
#
#   1. Postgres  — se POSTGRES_URL ou DATABASE_URL existir
#   2. Redis     — se KV_REST_API_URL/TOKEN ou UPSTASH_REDIS_REST_URL/TOKEN existir
#   3. Memória   — nenhum dos anteriores (o app sobe, mas o estado se perde a cada
#                  cold start da função serverless; use só em dev/preview)
#
# Sem nenhuma variável, o deploy na Vercel FUNCIONA — apenas não persiste.
# =============================================================================

# --- Opção 1: Postgres (Supabase) — o estado vive em TABELAS no schema `aurea` --
# Com POSTGRES_URL definida, getState()/mutateState() usam src/server/db/ (tabelas
# normalizadas, transação com FOR UPDATE). Sem ela, o blob JSON de src/server/store/.
#
# Supabase: use SEMPRE o host do pooler (termina em pooler.supabase.com). Porta 6543
# para a aplicação, 5432 só para `npm run db:migrate`. Ver
# docs/referencia/INFRAESTRUTURA_SUPABASE.md.
# POSTGRES_URL="postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
# POSTGRES_URL_DIRECT="postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
#
# Schema alternativo no MESMO banco — a "gaveta" do ambiente local, para não mexer
# no estado dos sócios. `npm run db:migrate` cria a gaveta; a primeira requisição
# semeia as 7 contas nela. Padrão: aurea.
# AUREA_DB_SCHEMA="aurea_local"
#
# Faz `npm test` rodar a suíte de banco TAMBÉM contra este Postgres real, num schema
# `aurea_test` descartável (prova o FOR UPDATE com duas conexões de verdade).
# AUREA_DB_TEST_URL="postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Opção 2: Redis (Vercel KV / Upstash) ------------------------------------
# Criando o banco pelo painel da Vercel (Storage > KV), estas duas entram sozinhas:
# KV_REST_API_URL="https://xxxx.upstash.io"
# KV_REST_API_TOKEN="AX...."
#
# Usando a Upstash direto, os nomes são estes:
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AX...."

# --- Sessão ------------------------------------------------------------------
# Segredo usado para assinar o cookie de sessão (HMAC). Gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele o app usa um segredo de desenvolvimento e avisa no log.
SESSION_SECRET=""

# --- Dados (só para o caminho SEM POSTGRES_URL — Redis ou memória) ------------
# Chave do estado compartilhado no blob JSON. Irrelevante quando o banco está
# configurado: com tabelas, quem separa ambientes é AUREA_DB_SCHEMA.
#
# DEIXE COMENTADA. Sem esta variável, o código usa o padrão de
# src/domain/constants.ts (hoje 'aurea-market-v6'), que é sempre o valor certo
# para o formato de estado da versão atual.
#
# Defini-la à mão só faz sentido para forçar um reinício limpo dos dados de
# teste (incrementando o sufixo) ou para separar bancos de preview e produção.
# Apontá-la para uma versão ANTERIOR é um defeito: ordens gravadas antes do
# mercado multi-ativo não têm `tipoMoeda`, e duas delas casam entre si porque
# `undefined === undefined` é verdadeiro. Ver docs/diario/CRITICAL_DEBUGS.md,
# item CD-01.
#
# AUREA_STORE_KEY="aurea-market-v6"

# --- Mercado Pago (frente C) — SANDBOX APENAS até o parecer jurídico (RA-01) ---
# Token de TESTE da aplicação. Nunca o de produção.
# MP_ACCESS_TOKEN_TEST=""
# Assinatura secreta do webhook (Suas integrações → Webhooks → Configurar).
# MP_WEBHOOK_SECRET=""
# Deixe ausente. Só 'false' liga produção — e isso depende do RA-01.
# MP_SANDBOX="true"
# SÓ EM DESENVOLVIMENTO LOCAL: aceita webhook sem assinatura. Nunca na Vercel.
# MP_WEBHOOK_ALLOW_UNSIGNED="true"
# Origem pública usada nos back_urls do Checkout Pro.
# NEXT_PUBLIC_APP_URL="https://aurea-custodia.vercel.app"

# --- Correios (frente C) — sem contrato, o adaptador determinístico responde ---
# CORREIOS_TOKEN=""
# CORREIOS_CARTAO_POSTAGEM=""

# --- Cron da Vercel ---
# Gere com: openssl rand -hex 32  (ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# A Vercel manda "Authorization: Bearer <valor>" sozinha quando a variável existe.
# CRON_SECRET=""
