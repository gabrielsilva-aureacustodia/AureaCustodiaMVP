# =============================================================================
# Áurea Custódia — variáveis de ambiente
# =============================================================================
# A camada de persistência é escolhida automaticamente pelo que estiver definido
# aqui, nesta ordem de prioridade (src/server/store/index.ts):
#
#   1. Postgres  — se POSTGRES_URL ou DATABASE_URL existir
#   2. Redis     — se KV_REST_API_URL/TOKEN ou UPSTASH_REDIS_REST_URL/TOKEN existir
#   3. Memória   — nenhum dos anteriores (o app sobe, mas o estado se perde a cada
#                  cold start da função serverless; use só em dev/preview)
#
# Sem nenhuma variável, o deploy na Vercel FUNCIONA — apenas não persiste.
# =============================================================================

# --- Opção 1: Postgres (Neon, Supabase, Vercel Postgres, RDS...) -------------
# POSTGRES_URL="postgres://usuario:senha@host/banco?sslmode=require"

# --- Opção 2: Redis (Vercel KV / Upstash) ------------------------------------
# Criando o banco pelo painel da Vercel (Storage > KV), estas duas entram sozinhas:
# KV_REST_API_URL="https://xxxx.upstash.io"
# KV_REST_API_TOKEN="AX...."
#
# Usando a Upstash direto, os nomes são estes:
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AX...."

# --- Sessão ------------------------------------------------------------------
# Segredo usado para assinar o cookie de sessão (HMAC). Gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele o app usa um segredo de desenvolvimento e avisa no log.
SESSION_SECRET=""

# --- Dados ---------------------------------------------------------------
# Chave do estado compartilhado. Trocar o sufixo (v5 -> v6) força um reinício
# limpo dos dados de teste em todos os dispositivos, como no MVP original.
AUREA_STORE_KEY="aurea-market-v5"
